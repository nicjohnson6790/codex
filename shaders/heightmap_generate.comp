#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

struct FinalGenerationDescriptor { uvec4 params; };
struct SourceDescriptor
{
    vec4 uvOriginAndHeightScale;
    vec4 uvSteps;
    vec4 ownershipBounds;
    uvec4 source;
};
struct HeightmapExtents { int minHeightCentimeters; int maxHeightCentimeters; };

layout(set=0, binding=0, std430) readonly buffer FinalGenerationBuffer { FinalGenerationDescriptor entries[]; } finals;
layout(set=0, binding=1, std430) readonly buffer SourceDescriptorBuffer { SourceDescriptor entries[]; } sources;
layout(set=0, binding=2, std430) readonly buffer SourceTileBuffer { float heights[]; } tiles;
layout(set=1, binding=0, std430) buffer HeightmapBuffer { float heights[]; } outputHeightmaps;
layout(set=1, binding=1, std430) buffer HeightmapExtentsBuffer { HeightmapExtents extents[]; } outputExtents;

const uint kFinalResolution = 259u;
const uint kSourceResolution = 256u;
const float kMissingSourceHeight = -12000.0;

float sampleTile(uint sliceIndex, vec2 coord)
{
    vec2 c = clamp(coord, vec2(0.0), vec2(255.0));
    ivec2 a = ivec2(floor(c));
    ivec2 b = min(a + ivec2(1), ivec2(255));
    vec2 f = fract(c);
    uint base = sliceIndex * kSourceResolution * kSourceResolution;
    float h00 = tiles.heights[base + uint(a.y) * kSourceResolution + uint(a.x)];
    float h10 = tiles.heights[base + uint(a.y) * kSourceResolution + uint(b.x)];
    float h01 = tiles.heights[base + uint(b.y) * kSourceResolution + uint(a.x)];
    float h11 = tiles.heights[base + uint(b.y) * kSourceResolution + uint(b.x)];
    return mix(mix(h00, h10, f.x), mix(h01, h11, f.x), f.y);
}

void main()
{
    uvec3 id = gl_GlobalInvocationID;
    if (id.x >= kFinalResolution || id.y >= kFinalResolution) return;
    FinalGenerationDescriptor generation = finals.entries[id.z];
    float height = 0.0;
    bool hasContribution = false;
    for (uint i = 0u; i < generation.params.z; ++i)
    {
        SourceDescriptor source = sources.entries[generation.params.y + i];
        vec2 coord = source.uvOriginAndHeightScale.xy +
            source.uvSteps.xy * float(id.x) + source.uvSteps.zw * float(id.y);
        bool ownsX = (coord.x > source.ownershipBounds.x || (source.source.y != 0u && coord.x >= source.ownershipBounds.x)) && coord.x <= source.ownershipBounds.z;
        bool ownsY = (coord.y > source.ownershipBounds.y || (source.source.z != 0u && coord.y >= source.ownershipBounds.y)) && coord.y <= source.ownershipBounds.w;
        if (ownsX && ownsY)
        {
            height += sampleTile(source.source.x, coord) * source.uvOriginAndHeightScale.z;
            hasContribution = true;
        }
    }
    if (!hasContribution) height = kMissingSourceHeight;
    uint slice = generation.params.x;
    uint linear = slice * kFinalResolution * kFinalResolution + id.y * kFinalResolution + id.x;
    outputHeightmaps.heights[linear] = height;
    int centimeters = int(round(height * 100.0));
    atomicMin(outputExtents.extents[slice].minHeightCentimeters, centimeters);
    atomicMax(outputExtents.extents[slice].maxHeightCentimeters, centimeters);
}
